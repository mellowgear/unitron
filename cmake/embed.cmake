# Usage: cmake -DOUT=embedded.cpp -DSRC_DIR=<repo> -P embed.cmake
# Writes a C++ file holding data files as byte arrays (portable: no long string literals).
function(embed_one var path)
  file(READ "${path}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
  set(${var} "${hex}" PARENT_SCOPE)
endfunction()
embed_one(HW "${SRC_DIR}/data/hwnames.tsv")
file(WRITE "${OUT}.tmp" "// generated by cmake/embed.cmake; do not edit\n#include \"embedded.hpp\"\nnamespace unitron {\nstatic const unsigned char hw[] = {\n${HW}0};\nconst std::string& embedded_hwnames_tsv() { static const std::string s(reinterpret_cast<const char*>(hw), sizeof hw - 1); return s; }\n}\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
