{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "'",
      "'"
    ]
  ],
  "wordPattern": "(AF')|(af')|([A-Za-z$][\\w?]*)|(\\d[0-9A-Fa-f]*[HhBbOoQqDd]?)"
}
