{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "asm900",
  "scopeName": "source.asm900",
  "comment": "Generated by scripts/gen-grammar.mjs from keywords.txt; do not edit by hand.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#macro"
    },
    {
      "include": "#control"
    },
    {
      "include": "#label"
    },
    {
      "include": "#text"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#mnemonic"
    },
    {
      "include": "#macrocall"
    },
    {
      "include": "#operands"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.semicolon.asm900",
          "match": ";.*$"
        },
        {
          "name": "comment.line.double-slash.asm900",
          "match": "//.*$"
        },
        {
          "name": "comment.block.asm900",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.asm900",
          "begin": "\"",
          "end": "\"(?!\")|$",
          "patterns": [
            {
              "name": "constant.character.escape.asm900",
              "match": "\"\""
            },
            {
              "name": "constant.character.escape.asm900",
              "match": "<[A-Za-z0-9_]+>|\\{[0-9A-Fa-f]{2}\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.asm900",
          "begin": "(?<![\\w.])'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.asm900",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "^\\s*(#\\s*include)\\s+(\"[^\"]*\"|<[^>]*>)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.include.asm900"
            },
            "2": {
              "name": "string.quoted.other.include.asm900"
            }
          }
        },
        {
          "match": "^\\s*(#\\s*define)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.define.asm900"
            },
            "2": {
              "name": "entity.name.function.preprocessor.asm900"
            }
          }
        },
        {
          "name": "keyword.control.directive.asm900",
          "match": "^\\s*#\\s*(?:undef|ifdef|ifndef|if|elif|else|endif|error|line)\\b"
        }
      ]
    },
    "macro": {
      "patterns": [
        {
          "match": "^\\s*(\\?macro)\\s+([A-Za-z_][\\w.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.macro.asm900"
            },
            "2": {
              "name": "entity.name.function.macro.asm900"
            }
          }
        },
        {
          "name": "keyword.control.macro.asm900",
          "match": "^\\s*\\?endm\\b"
        },
        {
          "match": "^\\s*(labels)\\s",
          "captures": {
            "1": {
              "name": "keyword.control.macro.asm900"
            }
          }
        },
        {
          "name": "variable.parameter.macro.asm900",
          "match": "\\?[A-Za-z_]\\w*"
        }
      ]
    },
    "control": {
      "match": "^\\s*(\\$(?i:CHARMAP|INCLUDE|MAXIMUM|MINIMUM|RESTORE|NOLIST|NORMAL|SYSTEM|EJECT|TITLE|LIST|NOLI|SAVE|EJ|LI|RS|SA|TT))(?![\\w.'])\\s*(\"[^\"]*\"|<[^>]*>)?",
      "captures": {
        "1": {
          "name": "keyword.control.directive.asm900"
        },
        "2": {
          "name": "string.quoted.other.include.asm900"
        }
      }
    },
    "label": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_.][\\w.']*)\\s+(?=(?i:equ|section)\\b)",
          "captures": {
            "1": {
              "name": "entity.name.constant.asm900"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_.][\\w.']*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.asm900"
            },
            "2": {
              "name": "punctuation.separator.label.asm900"
            }
          }
        },
        {
          "match": "^([A-Za-z_.][\\w.']*)(?=\\s|$)",
          "captures": {
            "1": {
              "name": "entity.name.function.label.asm900"
            }
          }
        }
      ]
    },
    "text": {
      "patterns": [
        {
          "match": "^\\s*(text|line|page)\\s+(?=\")",
          "captures": {
            "1": {
              "name": "keyword.other.text.asm900"
            }
          }
        },
        {
          "match": "^\\s*(done)\\s*(?=;|$)",
          "captures": {
            "1": {
              "name": "keyword.other.text.asm900"
            }
          }
        },
        {
          "match": "^\\s*(slot)\\s",
          "captures": {
            "1": {
              "name": "keyword.other.text.asm900"
            }
          }
        }
      ]
    },
    "directive": {
      "name": "storage.type.directive.asm900",
      "match": "(?<![\\w.'$?])(?i:(?:SYMBOL_A|SYMBOL_B|SYMBOL_N|SYMBOL_T|SECTION|EXTERN|FDATAD|FDATAS|FDATAX|MODULE|PUBLIC|ALIGN|FILE|LINE|DFB|DFD|DFL|DFP|DFW|DSB|DSD|DSL|DSP|DSW|END|EQU|ORG|DB|DD|DL|DP|DW))(?![\\w.'])"
    },
    "mnemonic": {
      "name": "keyword.operator.mnemonic.asm900",
      "match": "(?<![\\w.'$?])(?i:(?:NORMAL|ANDCF|MDEC1|MDEC2|MDEC4|MINC1|MINC2|MINC4|XORCF|BS1B|BS1F|CALL|CALR|CPDR|CPIR|DECF|DIVS|DJNZ|EXTS|EXTZ|HALT|INCF|LDAR|LDCF|LDDR|LDIR|LINK|MIRR|MULA|MULS|ORCF|PUSH|RETD|RETI|STCF|TSET|UNLK|ADC|ADD|AND|BIT|CAL|CCF|CHG|CPD|CPI|CPL|DAA|DEC|DIV|INC|JRL|LDA|LDC|LDD|LDF|LDI|LDX|MAX|MUL|NEG|NOP|PAA|POP|RCF|RES|RET|RLC|RLD|RRC|RRD|SBC|SCC|SCF|SET|SLA|SLL|SRA|SRL|SUB|SWI|XOR|ZCF|CP|DI|EI|EX|JP|JR|LD|OR|RL|RR|J)[BWL]?)(?![\\w.'])"
    },
    "macrocall": {
      "match": "^\\s+(?!(?:\\?|(?i:(?:NORMAL|ANDCF|MDEC1|MDEC2|MDEC4|MINC1|MINC2|MINC4|XORCF|BS1B|BS1F|CALL|CALR|CPDR|CPIR|DECF|DIVS|DJNZ|EXTS|EXTZ|HALT|INCF|LDAR|LDCF|LDDR|LDIR|LINK|MIRR|MULA|MULS|ORCF|PUSH|RETD|RETI|STCF|TSET|UNLK|ADC|ADD|AND|BIT|CAL|CCF|CHG|CPD|CPI|CPL|DAA|DEC|DIV|INC|JRL|LDA|LDC|LDD|LDF|LDI|LDX|MAX|MUL|NEG|NOP|PAA|POP|RCF|RES|RET|RLC|RLD|RRC|RRD|SBC|SCC|SCF|SET|SLA|SLL|SRA|SRL|SUB|SWI|XOR|ZCF|CP|DI|EI|EX|JP|JR|LD|OR|RL|RR|J)[BWL]?|SYMBOL_A|SYMBOL_B|SYMBOL_N|SYMBOL_T|SECTION|EXTERN|FDATAD|FDATAS|FDATAX|MODULE|PUBLIC|ALIGN|FILE|LINE|DFB|DFD|DFL|DFP|DFW|DSB|DSD|DSL|DSP|DSW|END|EQU|ORG|DB|DD|DL|DP|DW|text|line|page|done|slot|labels)(?![\\w.'])))([A-Za-z_][\\w.]*)(?=\\s|;|$)",
      "captures": {
        "1": {
          "name": "entity.name.function.macro.call.asm900"
        }
      }
    },
    "operands": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "name": "variable.language.register.asm900",
          "match": "(?<![\\w.'$?])(?i:QBC'|QBC0|QBC1|QBC2|QBC3|QDE'|QDE0|QDE1|QDE2|QDE3|QHL'|QHL0|QHL1|QHL2|QHL3|QIXH|QIXL|QIYH|QIYL|QIZH|QIZL|QSPH|QSPL|QWA'|QWA0|QWA1|QWA2|QWA3|RBC0|RBC1|RBC2|RBC3|RDE0|RDE1|RDE2|RDE3|RHL0|RHL1|RHL2|RHL3|RWA0|RWA1|RWA2|RWA3|XBC'|XBC0|XBC1|XBC2|XBC3|XDE'|XDE0|XDE1|XDE2|XDE3|XHL'|XHL0|XHL1|XHL2|XHL3|XWA'|XWA0|XWA1|XWA2|XWA3|BC'|DE'|HL'|IXH|IXL|IYH|IYL|IZH|IZL|QA'|QA0|QA1|QA2|QA3|QB'|QB0|QB1|QB2|QB3|QBC|QC'|QC0|QC1|QC2|QC3|QD'|QD0|QD1|QD2|QD3|QDE|QE'|QE0|QE1|QE2|QE3|QH'|QH0|QH1|QH2|QH3|QHL|QIX|QIY|QIZ|QL'|QL0|QL1|QL2|QL3|QSP|QW'|QW0|QW1|QW2|QW3|QWA|RA0|RA1|RA2|RA3|RB0|RB1|RB2|RB3|RC0|RC1|RC2|RC3|RD0|RD1|RD2|RD3|RE0|RE1|RE2|RE3|RH0|RH1|RH2|RH3|RL0|RL1|RL2|RL3|RW0|RW1|RW2|RW3|SPH|SPL|WA'|XBC|XDE|XHL|XIX|XIY|XIZ|XSP|XWA|A'|B'|BC|C'|D'|DE|E'|H'|HL|IX|IY|IZ|L'|QA|QB|QC|QD|QE|QH|QL|QW|SP|W'|WA|A|B|C|D|E|H|L|W)(?![\\w.])"
        },
        {
          "name": "variable.language.control-register.asm900",
          "match": "(?<![\\w.'$?])(?i:(?:INTNEST|DMAC0|DMAC1|DMAC2|DMAC3|DMAD0|DMAD1|DMAD2|DMAD3|DMAM0|DMAM1|DMAM2|DMAM3|DMAS0|DMAS1|DMAS2|DMAS3|XNSP))(?![\\w.'])"
        },
        {
          "name": "support.constant.condition.asm900",
          "match": "(?<![\\w.'$?])(?i:(?:NOV|UGT|ULE|GE|GT|LE|LT|MI|NC|NZ|OV|PL|C|F|T|Z))(?![\\w.'])"
        },
        {
          "name": "storage.modifier.asm900",
          "match": "(?<![\\w.'$?])(?i:(?:ROMDATA|STARTOF|MEDIUM|SIZEOF|LARGE|SMALL|BANK|CODE|COM0|DATA|LOC0|ABS))(?![\\w.'])"
        },
        {
          "name": "constant.numeric.hex.asm900",
          "match": "(?<![\\w.'$?])0[xX][0-9A-Fa-f]+(?![\\w.'])"
        },
        {
          "name": "constant.numeric.binary.asm900",
          "match": "(?<![\\w.'$?])0[yY][01]+(?![\\w.'])"
        },
        {
          "name": "constant.numeric.suffixed.asm900",
          "match": "(?<![\\w.'$?])[0-9][0-9A-Fa-f]*[HhBbOoQqDd](?![\\w.'])"
        },
        {
          "name": "constant.numeric.decimal.asm900",
          "match": "(?<![\\w.'$?])[0-9]+(?![\\w.'])"
        },
        {
          "name": "variable.language.location.asm900",
          "match": "\\$(?![\\w])"
        },
        {
          "match": "(:)(8|16|24|32)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.width.asm900"
            },
            "2": {
              "name": "constant.numeric.width.asm900"
            }
          }
        },
        {
          "name": "keyword.operator.asm900",
          "match": "<<|>>|[-+*/%&|^~=<>!]"
        },
        {
          "name": "punctuation.separator.comma.asm900",
          "match": ","
        },
        {
          "name": "variable.other.symbol.asm900",
          "match": "[A-Za-z_.][\\w.']*"
        }
      ]
    }
  }
}
