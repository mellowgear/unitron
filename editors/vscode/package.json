{
  "name": "unitron-asm900",
  "displayName": "unitron: TLCS-900 asm900",
  "description": "TLCS-900 (Neo Geo Pocket) asm900 source for the unitron toolchain: colouring, and go to definition, references, hover and errors through unitron lsp",
  "version": "0.1.0",
  "publisher": "mellowgear",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mellowgear/unitron"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "gen-grammar": "node scripts/gen-grammar.mjs",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/asm900.tmLanguage.json -g syntaxes/z80.tmLanguage.json -g syntaxes/lcf.tmLanguage.json -g syntaxes/charmap.tmLanguage.json \"test/grammar/*.test.*\"",
    "test": "npm run test:grammar",
    "compile": "npm run bundle -- --sourcemap",
    "watch": "npm run bundle -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run bundle -- --minify",
    "package": "vsce package --no-dependencies",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18"
  },
  "contributes": {
    "languages": [
      {
        "id": "asm900",
        "aliases": [
          "TLCS-900 asm900",
          "asm900"
        ],
        "extensions": [
          ".asm",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "z80unitron",
        "aliases": [
          "Z80 (unitron)",
          "z80"
        ],
        "extensions": [
          ".z80"
        ],
        "configuration": "./language-configuration-z80.json"
      },
      {
        "id": "lcf",
        "aliases": [
          "Link command file",
          "lcf"
        ],
        "extensions": [
          ".lcf"
        ],
        "configuration": "./language-configuration-lcf.json"
      },
      {
        "id": "charmap",
        "aliases": [
          "Character map",
          "charmap"
        ],
        "extensions": [
          ".charmap"
        ],
        "filenames": [
          "charmap.txt"
        ],
        "configuration": "./language-configuration-charmap.json"
      }
    ],
    "grammars": [
      {
        "language": "asm900",
        "scopeName": "source.asm900",
        "path": "./syntaxes/asm900.tmLanguage.json"
      },
      {
        "language": "z80unitron",
        "scopeName": "source.z80unitron",
        "path": "./syntaxes/z80.tmLanguage.json"
      },
      {
        "language": "lcf",
        "scopeName": "source.lcf",
        "path": "./syntaxes/lcf.tmLanguage.json"
      },
      {
        "language": "charmap",
        "scopeName": "source.charmap",
        "path": "./syntaxes/charmap.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "unitron",
      "properties": {
        "unitron.path": {
          "type": "string",
          "default": "unitron",
          "description": "The unitron binary: a path, or a name looked up on PATH."
        },
        "unitron.mainFile": {
          "type": "string",
          "default": "src/main.asm",
          "description": "Main source file, relative to the workspace root (unitron.json wins)."
        },
        "unitron.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "."
          ],
          "description": "Include directories, relative to the workspace root (unitron.json wins)."
        },
        "unitron.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the unitron output channel."
        }
      }
    },
    "commands": [
      {
        "command": "unitron.restartServer",
        "title": "Restart Language Server",
        "category": "unitron"
      },
      {
        "command": "unitron.showOutput",
        "title": "Show Output",
        "category": "unitron"
      }
    ],
    "problemMatchers": [
      {
        "name": "unitron-asm",
        "owner": "unitron",
        "source": "unitron asm",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):\\s+(error|warning)(?:\\s+([EW]\\d+))?:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        }
      }
    ]
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:asm900",
    "workspaceContains:unitron.json"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
