; generated by unitron text from slot.txt: edit the text, not this file
; names in 4-byte slots
Names:
; slot 4 FF
	db	0x01,0x02	; text "ab"
	db	0xFF	; done
	dfb	1,0xFF	; pad to 4
	db	0x01,0x02,0x01	; text "aba"	; exactly 4 bytes with the done
	db	0xFF	; done
	db	0x01,0x02,0x01,0x02	; text "abab"	; fills the slot: no terminator
	db	0x12	; text "{12}"
	db	0xFE,0x01	; line "a"
	db	0xFF	; done
	; text ""
	db	0xFF	; done
	dfb	3,0xFF	; pad to 4

Descs:
; slot 6 00
	db	0x01	; text "a"
	db	0xFF	; done
	dfb	4,0x00	; pad to 6
	; a comment inside the string
; slot 0
	db	0x02	; text "b"
	db	0xFF	; done
