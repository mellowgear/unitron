memory {
    ram (RW) : org=0x4000, len=0x1000
    rom (RX) : org=0x200000, len=0x1000
}
sections {
    code addr=0x200000 : { *(f_code) }
    rodata addr=align(0x10) : { *(f_const) }
    ram addr=0x4000 : { *(f_data) }
    code_end = addr(code) + sizeof(code);
    rodata_org = org(rodata);
    ram_size = sizeof(ram);
}
