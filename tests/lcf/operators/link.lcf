sections {
    code addr=0x200000 : { *(f_code) }
    rodata addr=0x200100 : { *(f_const) }
    ram addr=0x4000 : { *(f_data) }
    v1 = -1 + 2 * 3;          /* 5: unary, then * before + */
    v2 = ~0 & 0xFF;           /* 0xFF */
    v3 = !0 + !5;             /* 1 */
    v4 = 1 << 4 >> 2;         /* 4 */
    v5 = (3 < 4) + (4 > 3) + (3 <= 3) + (4 >= 5);   /* 3 */
    v6 = (1 == 1) | (2 != 2) << 1;                  /* 1 */
    v7 = 6 & 3 | 8;           /* 10 */
    v8 = 1 && 0 || 1;         /* 1 */
    v9 = 7 / 2 - 1;           /* 2 */
}
