memory {
    ram (RW) : org=0x4000, len=0x1000
    rom (RX) : org=0x200000, len=0x1000
}
/* a COPY section outputs its bytes and may overlap other sections (TR 8.3.5, Table 8-4) */
sections {
    code addr=0x200000 : { *(f_code) }
    rodata addr=0x200004 (COPY) : { *(f_const) }
    ram addr=0x4000 : { *(f_data) }
}
